meta {
  name: Create Article
  type: http
  seq: 8
}

post {
  url: {{host_api}}/articles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "title": "Hello World 123",
    "content": "<p class=\"editor-paragraph\"><strong>fgdgfdgfd</strong> <u>gdhgt</u> <em>ngcfbnhgfc</em></p>",
    "tags": ["tag123"],
    "coverImage": "http://someimagecom.com"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
